<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mybot_description</name>
  <version>0.1.0</version>
  <description>ROS2 30-day plan P1 D1: minimal differential robot (chassis + 2 wheels) URDF and display launch</description>
  <maintainer email="ren@example.com">ren</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行时依赖：描述发布 / 关节交互面板 / 可视化 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- D3 起：Gazebo 桥接与键盘遥控 -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- D4 起：ros2_control 栈 -->
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
