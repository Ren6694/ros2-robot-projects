# Normalize line endings: repo stores LF; checkout on Windows won't force CRLF on code.
* text=auto eol=lf

# Explicitly mark binary-ish files
*.png binary
*.jpg binary
*.urdf text
*.xacro text
*.world text
*.py text
*.yaml text
*.rviz text

# 如果哪天进库：.bat 必须 CRLF，否则 cmd 解析会出问题
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
