      <!-- 平行轴定理：I_origin = I_com + m*d^2，d 只在 z 方向，
           所以 Ixx/Iyy 各加 m*d^2，Izz 不变（d 与 z 轴平行）。 -->
      <inertia ixx="0.00024637499999999996" ixy="0.0" ixz="0.0" iyy="0.00024637499999999996" iyz="0.0" izz="6.074999999999999e-05"/>
    </inertial>
  </link>
  <!-- ============================ joint6 / link6 : 腕摆 =================== -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="0 0 0" xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit effort="8.0" lower="-2.9670597283903604" upper="2.9670597283903604" velocity="4.19"/>
    <dynamics damping="0.10" friction="0.02"/>
  </joint>
  <link name="link6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <cylinder length="0.02" radius="0.032"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.026"/>
      <geometry>
        <cylinder length="0.008" radius="0.036000000000000004"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.027 0.0 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.013500000000000003 0.02338268590217984 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.013499999999999995 0.023382685902179845 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.027 3.3065463576978537e-18 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.013500000000000012 -0.023382685902179835 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.013500000000000003 -0.02338268590217984 0.031"/>
      <geometry>
        <cylinder length="0.004" radius="0.003"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0315"/>
      <geometry>
        <cylinder length="0.005" radius="0.008"/>
      </geometry>
      <material name="black_rubber"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <cylinder length="0.03" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.015"/>
      <mass value="0.12"/>
      <inertia ixx="6.672e-05" ixy="0.0" ixz="0.0" iyy="6.672e-05" iyz="0.0" izz="6.144000000000001e-05"/>
    </inertial>
  </link>
  <!-- ====================== 夹爪（fixed 座 + 2 个 prismatic 指） ========== -->
  <joint name="gripper_mount" type="fixed">
    <parent link="link6"/>
    <child link="gripper_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.03"/>
  </joint>
  <link name="gripper_base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.008"/>
      <geometry>
        <box size="0.04 0.052 0.016"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0185"/>
      <geometry>
        <box size="0.03 0.044 0.005"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.019999999999999997 0.021"/>
      <geometry>
        <box size="0.012 0.006 0.008"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.019999999999999997 0.021"/>
      <geometry>
        <box size="0.012 0.006 0.008"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <box size="0.045 0.06 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.01"/>
      <mass value="0.1"/>
      <!-- 平行轴定理：I_origin = I_com + m*d^2，d 只在 z 方向，
           所以 Ixx/Iyy 各加 m*d^2，Izz 不变（d 与 z 轴平行）。 -->
      <inertia ixx="4.3333333333333334e-05" ixy="0.0" ixz="0.0" iyy="3.0208333333333334e-05" iyz="0.0" izz="4.6875e-05"/>
    </inertial>
  </link>
  <!-- 指片原点放在**指片几何中心**，所以惯量 com_z=0；开合方向用轴符号区分，
       两个关节的 limit 都是 [0, f_stroke]，正值一律表示"张开" —— 这样
       SRDF 的 group_state 和 JTC 的目标值读起来不会左右相反。 -->
  <joint name="finger1_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger1_link"/>
    <origin rpy="0 0 0" xyz="0 0.034 0.0475"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" lower="0.0" upper="0.04" velocity="0.10"/>
    <dynamics damping="0.50" friction="0.10"/>
  </joint>
  <link name="finger1_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.0175"/>
      <geometry>
        <box size="0.022 0.012 0.02"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.005"/>
      <geometry>
        <box size="0.018000000000000002 0.007 0.03"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.004 0.006"/>
      <geometry>
        <box size="0.016 0.006 0.026"/>
      </geometry>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.024"/>
      <geometry>
        <box size="0.014 0.009000000000000001 0.007"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.008 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="0.045"/>
      <!-- 平行轴定理：I_origin = I_com + m*d^2，d 只在 z 方向，
           所以 Ixx/Iyy 各加 m*d^2，Izz 不变（d 与 z 轴平行）。 -->
      <inertia ixx="1.1583749999999999e-05" ixy="0.0" ixz="0.0" iyy="1.284375e-05" iyz="0.0" izz="1.7399999999999999e-06"/>
    </inertial>
  </link>
  <joint name="finger2_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger2_link"/>
    <origin rpy="0 0 0" xyz="0 -0.034 0.0475"/>
    <axis xyz="0 -1 0"/>
    <limit effort="20.0" lower="0.0" upper="0.04" velocity="0.10"/>
    <dynamics damping="0.50" friction="0.10"/>
  </joint>
  <link name="finger2_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.0175"/>
      <geometry>
        <box size="0.022 0.012 0.02"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.005"/>
      <geometry>
        <box size="0.018000000000000002 0.007 0.03"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.004 0.006"/>
      <geometry>
        <box size="0.016 0.006 0.026"/>
      </geometry>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.024"/>
      <geometry>
        <box size="0.014 0.009000000000000001 0.007"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.008 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="0.045"/>
      <!-- 平行轴定理：I_origin = I_com + m*d^2，d 只在 z 方向，
           所以 Ixx/Iyy 各加 m*d^2，Izz 不变（d 与 z 轴平行）。 -->
      <inertia ixx="1.1583749999999999e-05" ixy="0.0" ixz="0.0" iyy="1.284375e-05" iyz="0.0" izz="1.7399999999999999e-06"/>
    </inertial>
  </link>
  <!-- ============ tool0：MoveIt 的规划末端（两指指尖之间的抓取中心） ======
       为什么不直接用 link6 当 tip：抓取规划关心的是"夹取点"在哪，
       把 tool0 定在指尖平面上，set_pose_target 给的目标就是物体要到的位置，
       不需要在业务代码里再补一个 75 mm 的偏置 —— 这类偏置是现场 bug 的高发区。 -->
  <joint name="tool0_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="tool0"/>
    <origin rpy="0 0 0" xyz="0 0 0.075"/>
  </joint>
  <link name="tool0">
    <visual>
      <geometry>
        <sphere radius="0.004"/>
      </geometry>
      <material name="tip_red"/>
    </visual>
    <!-- tool0 是纯坐标系，故意不给 collision：给了就会在 SRDF 里多出一堆
         "小球与指片相碰"的假阳性，还得逐条 disable。 -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <ros2_control name="arm6_mock_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <!-- 关掉"命令传感器"通道：本项目没有力/扭矩传感，避免 controller_manager
             为不存在的 sensor 接口分配状态位。 -->
      <param name="mock_sensor_commands">false</param>
      <!-- 0 偏置：仿真里不做"故意偏离指令"的故障注入，回归数字才可比。 -->
      <param name="state_following_offset">0.0</param>
    </hardware>
    <!-- 6 个臂关节：位置指令接口（JTC 的 position 模式） -->
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-2.792526803190927</param>
        <param name="max">2.792526803190927</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-1.7453292519943295</param>
        <param name="max">1.7453292519943295</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-2.0943951023931953</param>
        <param name="max">2.0943951023931953</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-2.9670597283903604</param>
        <param name="max">2.9670597283903604</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-2.0943951023931953</param>
        <param name="max">2.0943951023931953</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position">
        <param name="min">-2.9670597283903604</param>
        <param name="max">2.9670597283903604</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- 2 个指关节：单位是米（prismatic），限位与 URDF 的 [0, 0.040] 对齐。
           注意这里必须与 URDF <limit> 一致，否则 JTC 会按 ros2_control 的
           接口限位裁剪，而 MoveIt 按 URDF 限位规划 —— 两者不一致时表现为
           "规划成功但执行不到位"，很难查。 -->
    <joint name="finger1_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.040</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger2_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.040</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
