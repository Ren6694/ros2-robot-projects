            <diffuse>0.10 0.75 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 终点标记（红）===== -->
    <model name="goal_marker">
      <static>true</static>
      <pose>3.5000 2.5000 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
