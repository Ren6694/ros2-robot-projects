    <!-- ===== 起点标记（绿）===== -->
    <model name="start_marker">
      <static>true</static>
      <pose>-3.5000 -2.5000 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.004</length></cylinder></geometry>
          <material>
